# PostgreSQL Database Configuration
POSTGRES_DB=wood_shop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis Configuration
# ВАЖНО: Для production укажите сильный пароль!
# Если оставить пустым, Redis запустится без пароля (не рекомендуется для production)
REDIS_PASSWORD=your-strong-redis-password-here
REDIS_PORT=6379

# Backend Port
BACKEND_PORT=8000

# Frontend Port
FRONTEND_PORT=3000

# Frontend API URL (для production используйте ваш домен)
# Для разработки: http://localhost:8000
# Для production: https://skazkindomykt.ru
VITE_API_URL=https://skazkindomykt.ru

# Nginx Ports (для production)
HTTP_PORT=80
HTTPS_PORT=443

# Django Settings (добавьте эти переменные в apps/backend/.env)
# SECRET_KEY=your-secret-key-here
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_CHANNEL_ID=your-telegram-channel-id

