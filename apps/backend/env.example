# Django
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# База данных (по умолчанию SQLite, файл db.sqlite3 в apps/backend/)
# Для PostgreSQL раскомментируйте:
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/wood_shop

# Redis / Celery (опционально, для Telegram-уведомлений)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Email менеджеру о новых заявках (основной канал, если Telegram с VPS недоступен)
# Yandex пример:
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_USE_TLS=False
# EMAIL_HOST_USER=your@yandex.ru
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=Сказкин Дом <your@yandex.ru>
# ORDER_NOTIFY_EMAIL=manager@example.com
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ORDER_NOTIFY_EMAIL=

# CORS / CSRF (разработка)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production example:
# DEBUG=False
# ALLOWED_HOSTS=skazkindomykt.ru,www.skazkindomykt.ru
# SITE_URL=https://skazkindomykt.ru
# CORS_ALLOWED_ORIGINS=https://skazkindomykt.ru,https://www.skazkindomykt.ru
# CSRF_TRUSTED_ORIGINS=https://skazkindomykt.ru,https://www.skazkindomykt.ru
