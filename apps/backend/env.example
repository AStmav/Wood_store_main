# Django Secret Key (ОБЯЗАТЕЛЬНО измените в продакшене!)
# Сгенерируйте новый ключ командой:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-your-secret-key-CHANGE-IN-PRODUCTION

# Debug режим (False для продакшена)
DEBUG=True

# Разрешенные хосты (разделите запятыми)
# В продакшене: your-domain.com,www.your-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (опционально, если используете внешнюю БД)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Telegram Bot Configuration (для уведомлений о заказах)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHANNEL_ID=your-telegram-channel-id

# CORS (для разработки, в продакшене настройте через nginx)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email настройки (опционально)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-password

