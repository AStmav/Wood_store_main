[Unit]
Description=Wood Store Django (Gunicorn)
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/wood_store/apps/backend
Environment="PATH=/opt/wood_store/apps/backend/.venv/bin"
ExecStart=/opt/wood_store/apps/backend/.venv/bin/gunicorn furniture_store.wsgi:application \
  --bind 127.0.0.1:8000 \
  --workers 2 \
  --timeout 120 \
  --access-logfile - \
  --error-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
